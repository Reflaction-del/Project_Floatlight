{
  "name": "floating-light-v2",
  "private": true,
  "version": "2.2.8",
  "type": "module",
  "description": "萨卡萨卡斑斑~~",
  "author": "浮光",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron:dev": "vite build && electron .",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@tiptap/extension-color": "^2.27.2",
    "@tiptap/extension-font-family": "^2.27.2",
    "@tiptap/extension-image": "^2.10.0",
    "@tiptap/extension-placeholder": "^2.10.0",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/extension-text-style": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/pm": "^2.10.0",
    "@tiptap/react": "^2.10.0",
    "@tiptap/starter-kit": "^2.10.0",
    "@tiptap/suggestion": "^2.10.0",
    "@types/qrcode": "^1.5.6",
    "font-list": "^2.1.0",
    "katex": "^0.18.1",
    "marked": "^18.0.7",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tippy.js": "^6.3.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.fugu.light.preview",
    "productName": "浮光世界观编辑器",
    "icon": "public/logo/logo_1024x1024.png",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "af",
      "am",
      "ar",
      "bg",
      "bn",
      "ca",
      "cs",
      "da",
      "de",
      "el",
      "en-GB",
      "en-US",
      "es-419",
      "es",
      "et",
      "fa",
      "fi",
      "fil",
      "fr",
      "gu",
      "he",
      "hi",
      "hr",
      "hu",
      "id",
      "it",
      "ja",
      "kn",
      "ko",
      "lt",
      "lv",
      "ml",
      "mr",
      "ms",
      "nb",
      "nl",
      "pl",
      "pt-BR",
      "pt-PT",
      "ro",
      "ru",
      "sk",
      "sl",
      "sr",
      "sv",
      "sw",
      "ta",
      "te",
      "th",
      "tr",
      "uk",
      "ur",
      "vi",
      "zh-CN",
      "zh-TW"
    ],
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "language": "2052",
      "shortcutName": "浮光世界观编辑器",
      "artifactName": "浮光世界观编辑器_v2.2.8_Setup.exe",
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "浮光世界观编辑器_v2.2.8.exe"
    },
    "directories": {
      "output": "release"
    }
  }
}
